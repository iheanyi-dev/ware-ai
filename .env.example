# Copy this file to .env and fill in real values. Never commit .env itself.

# --- App ---
APP_NAME=eduplatform-ai-service
ENVIRONMENT=development
PORT=8000

# --- Database (Postgres + pgvector, wired up starting Phase 1) ---
# These individual POSTGRES_* vars are read by docker-compose.yml to configure
# the container. DATABASE_URL is what our Python app itself connects with.
POSTGRES_USER=eduplatform
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=eduplatform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://eduplatform:change-this-password@localhost:5432/eduplatform

# --- Anthropic API (chatbot generation, wired up starting Phase 5) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Internal service-to-service auth (wired up starting Phase 4) ---
# Your main backend must send this as: Authorization: Bearer <INTERNAL_API_KEY>
INTERNAL_API_KEY=change-this-to-a-random-string

# .env.example — add under a new section

# --- Embedding model (Phase 2 fine-tuned model, wired up starting Phase 3) ---
# Path to the unzipped fine_tuned_course_embedder/ folder downloaded from Colab.
EMBEDDING_MODEL_PATH=models/fine_tuned_course_embedder